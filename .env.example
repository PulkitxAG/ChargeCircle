# 1. Your Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Anon Public Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
